# ==============================================================================
# Flood Damage Space Mapper - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials before running.
# Never commit real credentials or .env files to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Configuration
# ------------------------------------------------------------------------------
# Port for the Node.js Express API gateway & Vite dev middleware
PORT=3000

# Runtime environment ('development', 'production', 'test')
NODE_ENV=development

# Base URL where this application is hosted (e.g. Cloud Run, Vercel, or localhost)
APP_URL="http://localhost:3000"

# Client-facing API Base URL (if frontend and backend are hosted on separate domains)
VITE_API_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. AI & Copilot Integration (Google Gemini API)
# ------------------------------------------------------------------------------
# Required for zero-hallucination bilingual situation reports & search grounding
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. Copernicus Data Space Ecosystem (CDSE) Access
# ------------------------------------------------------------------------------
# Optional: Used for real-time querying and downloading raw Sentinel-1 SAR 
# and Sentinel-2 optical scenes via the Copernicus Data Space OpenID Connect API.
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID="your_copernicus_client_id_here"
COPERNICUS_CLIENT_SECRET="your_copernicus_client_secret_here"

# ------------------------------------------------------------------------------
# 4. Python ML Microservice (Optional if running separate FastAPI service)
# ------------------------------------------------------------------------------
# URL where backend-python microservice is running (default: http://localhost:8000)
PYTHON_ML_SERVICE_URL="http://localhost:8000"
