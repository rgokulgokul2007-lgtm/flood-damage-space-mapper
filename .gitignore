# ==============================================================================
# Flood Damage Space Mapper - Monorepo GitIgnore
# Covers Node.js/Express, React/Vite, Python ML Microservices, and Geospatial Data
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Python Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Python Caches & Compiled Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Build & Compiler Outputs (React / Vite / TypeScript / Express)
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
server.js
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Secrets, Credentials & Local Environment Files
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.p12
*.crt
id_rsa*
secrets.json
service-account*.json
firebase-applet-config.json

# Keep template environment file tracked
!.env.example

