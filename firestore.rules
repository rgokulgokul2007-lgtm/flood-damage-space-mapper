rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSituationReport(data) {
      return data.keys().hasAll(['id', 'incidentName', 'preEventDate', 'postEventDate', 'damagedRoadKm', 'isolatedSettlementsCount', 'englishReport', 'nepaliReport', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.incidentName is string && data.incidentName.size() <= 200
        && data.preEventDate is string && data.preEventDate.size() <= 30
        && data.postEventDate is string && data.postEventDate.size() <= 30
        && data.damagedRoadKm is number
        && data.isolatedSettlementsCount is number
        && data.englishReport is string && data.englishReport.size() <= 50000
        && data.nepaliReport is string && data.nepaliReport.size() <= 50000;
    }

    function isValidSearchAudit(data) {
      return data.keys().hasAll(['id', 'locationName', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.locationName is string && data.locationName.size() <= 200;
    }

    // Situation reports collection
    match /situation_reports/{reportId} {
      allow read: if isValidId(reportId);
      allow create: if isValidId(reportId) && isValidSituationReport(request.resource.data);
      allow update, delete: if false; // Immutable audit log
    }

    // Search audit logs collection
    match /search_audits/{auditId} {
      allow read: if isValidId(auditId);
      allow create: if isValidId(auditId) && isValidSearchAudit(request.resource.data);
      allow update, delete: if false; // Immutable audit log
    }
  }
}
